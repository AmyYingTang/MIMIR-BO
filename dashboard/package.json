{
  "name": "mimir-bo-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "MIMIR-BO Dashboard — Structured workbench for MIMIR-driven development",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev -- --port 5173",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "glob": "^11.0.1",
    "js-yaml": "^4.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
